 focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,520][1027,578]" /><node index="1" text="用户服务协议和隐私权政策" resource-id="com.chinaamc.MainActivityAMC:id/tv_title" class="android.widget.TextView" package="com.chinaamc.MainActivityAMC" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,578][1027,635]" /><node index="2" text="" resource-id="" class="android.widget.ScrollView" package="com.chinaamc.MainActivityAMC" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,656][1027,1759]"><node index="0" text="" resource-id="com.chinaamc.MainActivityAMC:id/ll_content" class="android.widget.LinearLayout" package="com.chinaamc.MainActivityAMC" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,656][1027,1759]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="com.chinaamc.MainActivityAMC" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[115,656][964,1759]"><node index="0" text="" resource-id="" class="android.widget.ScrollView" package="com.chinaamc.MainActivityAMC" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[115,695][964,1399]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="com.chinaamc.MainActivityAMC" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[115,695][947,1399]"><node index="0" text="感谢您使用华夏基金管家App。华夏基金深知个人信息和隐私保护的重要性，我们将全力保证您的信息安全和享受相关服务的权利。在您使用本产品或服务之前，请您认真、完整阅读以下文件，了解具体内容。" resource-id="" class="android.widget.TextView" package="com.chinaamc.MainActivityAMC" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[115,695][947,1007]" /><node index="1" text="根据《常见类型移动互联网应用程序必要个人信息范围规定》和基金开户、反洗钱及投资者适当性管理等法定要求，华夏基金管家App类型为投资理财类，基本业务功能为基金相关投资理财服务。必要个人信息范围包括:&#10;1.用户移动电话号码；&#10;2.投资理财用户姓名、证件类型和号码、证件有效期限、证件影印件；&#10;3.投资理财用户资金账户、银行卡号码或支付账号；&#10;4.投资理财用户交易记录、交易密码；&#10;5.投资理财用户适当性信息：收入来源、家庭可支配年收入、投资金融资产占家庭总资产比例、资产负债情况、投资经验、投资时长、重点投资品种、投资态度、偏好组合、可承受最大回撤、是否有不良诚信记录（用于完成风险测评及适当性管理）；&#10;6.投资理财用户其他开户必要信息：职业、地址、税收居民身份确认信息。&#10;如您拒绝提供上述信息，将无法使用相应的基本功能，但不影响您使用浏览等其他功能。&#10;选择“同意”后，我们才能为您提供信息发布、投资交易以及更多产品和服务。您也可以在“我的—相关协议”中查看下列文件。" resource-id="com.chinaamc.MainActivityAMC:id/tv_privacy_new_text" class="android.widget.TextView" package="com.chinaamc.MainActivityAMC" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[115,1028][947,1399]" /></node></node><node index="1" text="我们将严格保护您的个人信息，敬请查阅《华夏基金管理有限公司电子交易服务协议》、《华夏基金管理有限公司隐私权政策》、《华夏基金管理有限公司用户协议》、《华夏基金管理有限公司声明》、《网上交易风险揭示》全文" resource-id="com.chinaamc.MainActivityAMC:id/privacy_all_agreement" class="android.widget.TextView" package="com.chinaamc.MainActivityAMC" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[115